# ================================
# OfferGraph 环境变量配置
# 复制此文件为 .env 并填入实际值
# ================================

# ── LLM 配置（必填） ──
LLM_API_BASE=http://ai-gateway.wps.cn/api/v3
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_GATEWAY_UID=your-uid
LLM_GATEWAY_PRODUCT=your-product
LLM_GATEWAY_INTENTION=your-intention

# ── 搜索引擎（可选） ──
SEARCH_API_KEY=your-serpapi-key

# ── 平台 Cookie（可选，不填则跳过对应平台） ──
XHS_COOKIE=
MAIMAI_COOKIE=

# ── 平台开关（可选，默认开启） ──
NOWCODER_ENABLED=true
MAIMAI_ENABLED=true
XHS_ENABLED=true

# ── Redis（可选，默认本地） ──
REDIS_URL=redis://localhost:6379/0

# ── 数据库（可选，默认 SQLite） ──
DATABASE_URL=sqlite+aiosqlite:///./offergraph.db

# ── 服务器（可选） ──
HOST=127.0.0.1
PORT=8000
